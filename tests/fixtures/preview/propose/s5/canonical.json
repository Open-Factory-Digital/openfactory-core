{
  "name": "openfactory",
  "networks": {
    "default": {
      "name": "openfactory_default"
    }
  },
  "services": {
    "db": {
      "environment": {
        "POSTGRES_DB": "app",
        "POSTGRES_PASSWORD": "app",
        "POSTGRES_USER": "app"
      },
      "healthcheck": {
        "interval": "2s",
        "retries": 30,
        "test": [
          "CMD-SHELL",
          "pg_isready -U app -d app"
        ],
        "timeout": "5s"
      },
      "image": "postgres:16",
      "networks": {
        "default": null
      },
      "volumes": [
        {
          "source": "db-data",
          "target": "/var/lib/postgresql/data",
          "type": "volume",
          "volume": {}
        }
      ]
    },
    "shop": {
      "build": {
        "context": "/pv/base/app",
        "dockerfile": ".openfactory/preview/shop.Dockerfile"
      },
      "depends_on": {
        "db": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "environment": {
        "DATABASE_URL": "postgres://app:app@db:5432/app",
        "DJANGO_DEBUG": "1"
      },
      "networks": {
        "default": null
      }
    }
  },
  "volumes": {
    "db-data": {
      "name": "openfactory_db-data"
    }
  }
}
