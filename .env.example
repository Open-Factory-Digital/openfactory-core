# Copy to .env (gitignored) and fill in. Loaded automatically by the CLI and API.

# --- GitHub App (recommended): the platform auto-mints ~1h tokens from the key ---
OPENFACTORY_GH_APP_ID=
OPENFACTORY_GH_APP_INSTALLATION_ID=
OPENFACTORY_GH_APP_KEY=/absolute/path/to/app-private-key.pem

# --- Branding (the panel title/header + API title) ---
OPENFACTORY_PLATFORM_NAME=OpenFactory

# --- Bot actor (git commit author) ---
OPENFACTORY_BOT_NAME=OpenFactory Bot
OPENFACTORY_BOT_EMAIL=openfactory-bot@yourco.com

# --- Coding agent auth (INSIDE the sandbox) ---
# Worktree uses the host's `claude` login (no token needed). The CONTAINER injects
# one of these. Subscription: `claude setup-token` -> a ~1y token. Or an API key.
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# --- Alternatives / per-axis (optional) ---
# OPENFACTORY_BOT_TOKEN=      # a bot PAT, instead of the App (opaque token, all axes)
# OPENFACTORY_TRACKER_TOKEN=  # override for a split setup (e.g. Jira tracker)
# OPENFACTORY_FORGE_TOKEN=    # override for a split setup (e.g. GitLab forge)
# OPENFACTORY_BOT_LOGIN=      # a REAL bot-account login for assignee/claim (not an App)

# --- Prod approvers (manage with `openfactory approver add <login>`; stored hashed in
# ~/.openfactory/approvers.json). Env override for CI: JSON of login -> sha256(password). ---
# OPENFACTORY_APPROVERS={"alice":"<sha256>","bob":"<sha256>"}

# --- Where the tech-lead speaks (ADR-0015, ADR-0038). Unset, it is the PANEL — the channel that
# always exists, and the reason nothing in this section is required. A chat channel is an ADD-ON
# PACKAGE: the core reads none of its variables, the rows that package registers declare the
# names they read, and its README lists them. ONE line belongs here even so, because the CORE
# reads it — the declaration of which installed kind is the deployment-wide fallback. ---
# OPENFACTORY_NOTIFIER_FALLBACK=      # DECLARES the deployment-wide fallback notifier — a KIND on
#                                     # the notifier axis, from a package the deployment installed.
#                                     # Unset: project-less speech goes to the panel. Never inferred
#                                     # from a package's variables; `openfactory doctor` prints the
#                                     # state as one line and names what an installed row still needs.
# A project's own channel is named in the REGISTRY, never here (docs/reference/configuration.md
# §The registry): a chat coordinate there selects the chat kind, and a kind no installed package
# declares is refused by name when the channel is built. Per-project credentials follow the same
# rule as every other axis — the registry NAMES the variable (`channel_options.bot_token_env`),
# this file HOLDS the value, so a second project in a second workspace names its own.
